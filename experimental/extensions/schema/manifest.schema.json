{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCL RH declarative extension lab v1",
  "description": "Editor-assist structural schema. Runtime additionally rejects duplicate object keys, reserved keys, control/bidi characters, whitespace, incompatible API intervals, duplicate IDs and undeclared capabilities, and enforces byte/complexity limits.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pcl-linux.declarative-extension"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){1,7}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})(?![\\s\\S])"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "scope": {
      "description": "Running surface. Older manifests without this field use launcher; the original manifest digest is retained.",
      "enum": ["launcher", "rh-code", "both"]
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxExclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "min",
        "maxExclusive"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "ui.cards",
              "launcher.navigate",
              "instances.summary"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "id",
          "required",
          "reason"
        ]
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
              },
              "slot": {
                "enum": [
                  "home.secondary",
                  "tools.cards",
                  "rh-code.cards"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "actions": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "kind": {
                          "const": "navigate"
                        },
                        "target": {
                          "enum": [
                            "launch",
                            "instances",
                            "downloads",
                            "tools",
                            "settings"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "kind",
                        "target"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "kind": {
                          "const": "show-instance-summary"
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "kind"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "id",
              "slot",
              "title",
              "text",
              "actions"
            ]
          }
        }
      },
      "required": [
        "cards"
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "launcher" } } },
      "then": {
        "properties": {
          "contributions": {
            "properties": {
              "cards": { "items": { "properties": { "slot": { "enum": ["home.secondary", "tools.cards"] } } } }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["scope"], "properties": { "scope": { "const": "rh-code" } } },
      "then": {
        "properties": {
          "contributions": {
            "properties": {
              "cards": { "items": { "properties": { "slot": { "const": "rh-code.cards" } } } }
            }
          }
        }
      }
    }
  ],
  "required": [
    "format",
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher",
    "api",
    "capabilities",
    "contributions"
  ]
}
