{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCL RH plugin manifest v1",
  "description": "Editor-assist structural schema. Runtime additionally rejects duplicate object keys, reserved keys, control/bidi characters, whitespace, incompatible API intervals, duplicate IDs and undeclared capabilities, and enforces byte/complexity limits.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pcl-linux.declarative-extension"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){1,7}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})(?![\\s\\S])"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "scope": {
      "description": "Running surface. Older manifests without this field use launcher; the original manifest digest is retained.",
      "enum": [
        "launcher",
        "rh-code",
        "both"
      ]
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxExclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "min",
        "maxExclusive"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "ui.cards",
              "launcher.navigate",
              "instances.summary",
              "storage.settings",
              "launcher.appearance",
              "clipboard.write"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "id",
          "required",
          "reason"
        ]
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
              },
              "slot": {
                "enum": [
                  "home.secondary",
                  "tools.cards",
                  "rh-code.cards",
                  "settings.cards"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "actions": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "kind": {
                          "const": "navigate"
                        },
                        "target": {
                          "enum": [
                            "launch",
                            "instances",
                            "downloads",
                            "tools",
                            "settings"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "kind",
                        "target"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "kind": {
                          "const": "show-instance-summary"
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "kind"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "kind": {
                          "const": "set-launcher-appearance"
                        },
                        "values": {
                          "type": "object",
                          "minProperties": 1,
                          "maxProperties": 6,
                          "additionalProperties": false,
                          "properties": {
                            "theme": {
                              "oneOf": [
                                {
                                  "enum": [
                                    "system",
                                    "light",
                                    "dark"
                                  ]
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "setting": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                                    }
                                  },
                                  "required": [
                                    "setting"
                                  ]
                                }
                              ]
                            },
                            "custom_cursor": {
                              "oneOf": [
                                {
                                  "type": "boolean"
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "setting": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                                    }
                                  },
                                  "required": [
                                    "setting"
                                  ]
                                }
                              ]
                            },
                            "cursor_style": {
                              "oneOf": [
                                {
                                  "enum": [
                                    "accent",
                                    "outline"
                                  ]
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "setting": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                                    }
                                  },
                                  "required": [
                                    "setting"
                                  ]
                                }
                              ]
                            },
                            "cursor_size": {
                              "oneOf": [
                                {
                                  "enum": [
                                    "small",
                                    "standard"
                                  ]
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "setting": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                                    }
                                  },
                                  "required": [
                                    "setting"
                                  ]
                                }
                              ]
                            },
                            "custom_context_menu": {
                              "oneOf": [
                                {
                                  "type": "boolean"
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "setting": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                                    }
                                  },
                                  "required": [
                                    "setting"
                                  ]
                                }
                              ]
                            },
                            "context_menu_density": {
                              "oneOf": [
                                {
                                  "enum": [
                                    "comfortable",
                                    "compact"
                                  ]
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "setting": {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                                    }
                                  },
                                  "required": [
                                    "setting"
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "kind",
                        "values"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "kind": {
                          "const": "copy-text"
                        },
                        "setting": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "kind",
                        "setting"
                      ]
                    }
                  ]
                }
              },
              "fields": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
                }
              }
            },
            "required": [
              "id",
              "slot",
              "title",
              "text",
              "actions"
            ]
          }
        }
      },
      "required": [
        "cards"
      ]
    },
    "settings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "const": "text"
              },
              "default": {
                "type": "string",
                "maxLength": 4000
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4000
              },
              "multiline": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "default",
              "maxLength"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "const": "toggle"
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "default"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "const": "select"
              },
              "default": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ]
                }
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "default",
              "options"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}(?![\\s\\S])"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "const": "number"
              },
              "default": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "min": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "max": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "default",
              "min",
              "max"
            ]
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "launcher"
          }
        }
      },
      "then": {
        "properties": {
          "contributions": {
            "properties": {
              "cards": {
                "items": {
                  "properties": {
                    "slot": {
                      "enum": [
                        "home.secondary",
                        "tools.cards",
                        "settings.cards"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "const": "rh-code"
          }
        }
      },
      "then": {
        "properties": {
          "contributions": {
            "properties": {
              "cards": {
                "items": {
                  "properties": {
                    "slot": {
                      "const": "rh-code.cards"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "format",
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher",
    "api",
    "capabilities",
    "contributions"
  ]
}
