<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AssemblyName>PclRh.NCompatibilityProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="fixtures/**/*.cs" />
    <ProjectReference Include="$(PclNSdkRoot)/src/PCL.N.Plugin.Abstractions/PCL.N.Plugin.Abstractions.csproj" />
    <ProjectReference Include="$(PclNSdkRoot)/src/PCL.N.Plugin.i18n/PCL.N.Plugin.i18n.csproj" />
  </ItemGroup>
  <Target Name="RequireSdkSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PclNSdkRoot)' == ''" Text="Pass PclNSdkRoot pointing to the pinned public PCL N SDK source." />
  </Target>
</Project>
